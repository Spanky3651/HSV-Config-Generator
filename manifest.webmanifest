{
  "id": "./",
  "name": "HSV Config Generator",
  "short_name": "HSV Config",
  "description": "Design Beat Saber HitScoreVisualizer configs with a live in-game preview, tune them from your replays, and push them to your Quest.",
  "start_url": "./?utm_source=pwa&utm_campaign=installed",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "background_color": "#05070c",
  "theme_color": "#05070c",
  "categories": ["games", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    {
      "action": "./?utm_source=pwa&utm_campaign=open-file",
      "accept": {
        "application/json": [".json"],
        "application/x-hsv-config": [".hsv", ".hsvconfig"]
      },
      "icons": [
        { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "launch_type": "single-client"
    },
    {
      "action": "./?utm_source=pwa&utm_campaign=open-file",
      "accept": { "application/x-beat-saber-replay": [".bsor"] },
      "icons": [
        { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
      ],
      "launch_type": "single-client"
    }
  ]
}
